# ─── API de Claude (Anthropic) ───────────────────────────────
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Grupos de WhatsApp autorizados ──────────────────────────
# IDs de los grupos separados por comas (sin espacios)
# Formato: XXXXXXXXXXX@g.us,YYYYYYYYYYY@g.us
# Los IDs aparecen en los logs cuando el bot recibe el primer mensaje de cada grupo
# Si se deja vacío, el bot responde en TODOS los grupos (solo para desarrollo)
GRUPOS_AUTORIZADOS=

# ─── Número del administrador ────────────────────────────────
# Tu número de teléfono (sin + ni espacios, con código de país)
# Ejemplo para España: 34612345678
ADMIN_NUMERO=34600000000

# ─── Hora del resumen diario ─────────────────────────────────
# Formato cron: minuto hora * * *
# Por defecto: 09:00 todos los días
HORA_RESUMEN_DIARIO=0 9 * * *
